{
  "name": "@onetab/payment-proof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "25.9.0" },
  "scripts": {
    "proof": "node --import tsx src/cli.ts",
    "lint": "eslint src test",
